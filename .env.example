# Local PostgreSQL (use Docker: docker run -d -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mailflow"

# Railway auto-injects DATABASE_URL when you add a PostgreSQL plugin

JWT_SECRET="your-long-random-secret-here"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
WORKER_INTERVAL_MS=5000
ENABLE_INLINE_WORKER=true

# Real SMTP (optional — or configure in Settings UI)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM_EMAIL="your@gmail.com"
SMTP_FROM_NAME="MailFlow"
SMTP_NAME="Gmail"
SMTP_SENDER_NAME="Muhammad"
EMAIL_DELIVERY_MODE="primary"

# Casino Royal USA links (used in email templates)
NEXT_PUBLIC_WEBSITE_URL="https://casinoroyalusa.com"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/casinoroyalusa12"

# primary = Gmail Primary tab | marketing = Promotions tab
EMAIL_DELIVERY_MODE="primary"

# Deliverability: keep false for branded emails (no tracking pixel / link wrapping)
EMAIL_TRACKING_ENABLED="false"

# If emails land in Spam, set true to send text-only (no images) in primary mode
EMAIL_STRIP_IMAGES_IN_PRIMARY="false"

# Display name in recipient inbox (From field)
SMTP_SENDER_NAME="Casino Royal USA"

# Autopilot send window (0–24 = anytime). Old default was 9–18 only.
AUTOPILOT_SEND_START="0"
AUTOPILOT_SEND_END="24"
AUTOPILOT_TIMEZONE="Asia/Karachi"
AUTOPILOT_24_7="true"
ENABLE_INLINE_WORKER="true"
NEXT_PUBLIC_CONTACT_PHONE="+917080849048"
